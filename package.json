{
  "name": "@wilsoon/eslint-config",
  "version": "0.3.3",
  "description": "Opinionated ESLint + Prettier shared config with custom autofixable rules for cleaner JS/TS code.",
  "type": "module",
  "exports": {
    "./eslint": "./eslint/index.js",
    "./prettier": "./prettier/index.js"
  },
  "scripts": {
    "postinstall": "node ./scripts/postinstall.js"
  },
  "files": [
    "bin/",
    "eslint/",
    "prettier/",
    "scripts/",
    "README.md"
  ],
  "keywords": [
    "eslint",
    "eslint-config",
    "prettier",
    "prettier-config",
    "linting",
    "formatting",
    "typescript",
    "javascript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wilsoon7721/ESLint-Config.git"
  },
  "bugs": {
    "url": "https://github.com/Wilsoon7721/ESLint-Config/issues"
  },
  "homepage": "https://github.com/Wilsoon7721/ESLint-Config#readme",
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "dependencies": {
    "eslint": "^10.0.0",
    "typescript-eslint": "^8.0.0",
    "@stylistic/eslint-plugin": "^3.0.0",
    "prettier": "^3.0.0"
  },
  "bin": {
    "eslint-config": "./bin/cli.js",
    "wilsoon-lint-setup": "./bin/cli.js",
    "wlint": "./bin/lint.js"
  }
}